# Supabase PostgreSQL is required unless SCM_ALLOW_SQLITE=true is explicitly set for local development.
# For Supabase/Postgres, copy this file to .env and fill in your own password/host.
#
# SCM_DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
#
# Optional local-only SQLite fallback.
# SCM_ALLOW_SQLITE=true
# Optional persistent fallback for SQLite if OneDrive locks the project DB.
# SCM_WRITABLE_DATA_DIR=C:\Users\YOUR_NAME\.scm_portal\data
