# Local development example only. Do not commit real secrets.

# Main app database. Streamlit Cloud should define the same keys in Secrets.
# Supabase Shared Pooler requires username postgres.[PROJECT_REF].
# Session Pooler: port 5432. Transaction Pooler: port 6543.
# Copy the connection string from Supabase Dashboard > Connect.
SCM_DATABASE_URL="postgresql+psycopg2://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
SCM_USE_SUPABASE_DB=true

# Supabase REST API diagnostics.
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_KEY="[SUPABASE_ANON_OR_PUBLISHABLE_KEY]"

# Set false to use local SQLite for development.
# Never use SQLite for production Cloud data persistence.
# SCM_USE_SUPABASE_DB=false
# SCM_WRITABLE_DATA_DIR=C:\Users\YOUR_NAME\.scm_portal\data
