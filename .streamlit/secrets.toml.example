# Streamlit Cloud Secrets example. Do not commit real secrets.

SCM_DATABASE_URL = "postgresql+psycopg2://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
SCM_USE_SUPABASE_DB = true

SUPABASE_URL = "https://[PROJECT_REF].supabase.co"
SUPABASE_KEY = "[SUPABASE_ANON_OR_PUBLISHABLE_KEY]"
